const gas = [2,1,5,3,2]
const cost = [3,1,2,4,1]

var canCompleteCircuit = function(gas, cost) {
   
let totalGas = 0;
let totalCost = 0;

for(let i=0; i<gas.length; i++){
let tank = 0;

    totalGas += gas[i];
    totalCost += cost[i];
}
  if(totalGas < totalCost) return -1;

let start = 0;
let tank = 0;

for(let i=0; i<gas.length; i++){

tank += gas[i] - cost[i];

if(tank < 0){
start = i + 1;
tank = 0;
}
}
return start
};
